import{readFile,writeFile,stat,unlink}from'node:fs/promises';import{createReadStream}from'node:fs';import{Readable}from'node:stream';import{createGunzip}from'node:zlib';import{createHash}from'node:crypto';import assert from'node:assert/strict';
const base='/workspace/afkarena-simx/',stamp='2026-10-30T16-54-08.837Z',reportFile='benchmarks/results/'+stamp+'-rust-program-perf.json',journalFile='benchmarks/validation/profile-raw-cleanup-source-shortcut-2026-10-30.json',bytes=await readFile(base+reportFile),r=JSON.parse(bytes),priorFile='benchmarks/validation/profile-data-cleanup-current-2026-10-30.json',prior=JSON.parse(await readFile(base+priorFile)),hash=b=>createHash('sha256').update(b).digest('hex'),prefix=base+'work/rust-program-perf/'+stamp;assert.equal(r.profileSucceeded,true);assert.equal(r.semanticReportMatched,true);const suffix={data:'.data','record-stdout':'.record.stdout','record-stderr':'.record.stderr',leaf:'.leaf.stdout','leaf-stderr':'.leaf.stderr',inclusive:'.inclusive.stdout','inclusive-stderr':'.inclusive.stderr',stacks:'.stacks.stdout','stacks-stderr':'.stacks.stderr',buildids:'.buildids.stdout','buildids-stderr':'.buildids.stderr'};const journal={startedAt:new Date().toISOString(),passed:false,report:{file:reportFile,sha256:hash(bytes)},priorDataCleanup:{file:priorFile,sha256:hash(await readFile(base+priorFile))},scope:'Only this completed current capture raw data and parsed perf reports. All source/control inputs, ELFs, rlibs, parsed JSON, compressed observations and reports remain. Every archive chunk and concatenated gunzip length/hash verified before deletion; raw bytes independently hashed when still present. Earlier data deletion reconciles against the control journal.',rows:[]};async function streamHash(file){const h=createHash('sha256');let bytes=0;for await(const chunk of createReadStream(file)){h.update(chunk);bytes+=chunk.length;}return{sha256:h.digest('hex'),bytes};}
for(const a of r.artifacts){assert.ok(Object.hasOwn(suffix,a.label));const chunks=[];for(const c of a.chunks){assert.ok(c.file.startsWith('benchmarks/results/'+stamp+'-rust-program-perf.'));const got=await streamHash(base+c.file);assert.equal(got.sha256,c.sha256);assert.equal(got.bytes,c.bytes);chunks.push({...c});}const source=Readable.from((async function*(){for(const c of chunks)for await(const b of createReadStream(base+c.file))yield b;})());const gunzip=source.pipe(createGunzip()),h=createHash('sha256');let count=0;for await(const b of gunzip){h.update(b);count+=b.length;}const decoded={sha256:h.digest('hex'),bytes:count};assert.equal(decoded.sha256,a.uncompressedSha256);assert.equal(decoded.bytes,a.uncompressedBytes);const raw=prefix+suffix[a.label],row={label:a.label,raw:raw.slice(base.length),chunks,decoded};let exists=true;try{await stat(raw)}catch(e){if(e.code==='ENOENT')exists=false;else throw e;}if(exists){row.rawVerified=await streamHash(raw);assert.deepEqual(row.rawVerified,decoded);row.action='pending-remove';}else{assert.equal(a.label,'data');const old=prior.rows.find(x=>base+x.raw===raw);assert.ok(old);assert.equal(old.sha256,decoded.sha256);assert.equal(old.bytes,decoded.bytes);row.action='already-removed-after-control-verification';}journal.rows.push(row);}
await writeFile(base+journalFile,JSON.stringify(journal,null,2)+'\n');for(const row of journal.rows)if(row.action==='pending-remove'){assert.deepEqual(await streamHash(base+row.raw),row.decoded);await unlink(base+row.raw);row.action='removed';}journal.passed=true;journal.finishedAt=new Date().toISOString();journal.newBytesReclaimed=journal.rows.filter(x=>x.action==='removed').reduce((n,x)=>n+x.decoded.bytes,0);journal.totalCaptureRawBytesReclaimed=journal.rows.reduce((n,x)=>n+x.decoded.bytes,0);await writeFile(base+journalFile,JSON.stringify(journal,null,2)+'\n');console.log(JSON.stringify({journalFile,passed:true,newBytesReclaimed:journal.newBytesReclaimed,totalCaptureRawBytesReclaimed:journal.totalCaptureRawBytesReclaimed}));
