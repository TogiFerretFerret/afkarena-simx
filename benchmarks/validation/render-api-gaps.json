      "sha256": "887b945dba05d41b5aca289781a112f3ef50eb4ad266fc46303f43488fa11e8e",
      "source": "    setAdditionalTransform: function (additionalTransform) {\n        if(additionalTransform === undefined)\n            return this._additionalTransformDirty = false;\n        this._additionalTransform = additionalTransform;\n        this._renderCmd.setDirtyFlag(cc.Node._dirtyFlags.transformDirty);\n        this._additionalTransformDirty = true;\n    },"
    },
    "setSkin": {
      "url": "https://raw.githubusercontent.com/cocos2d/cocos2d-html5/c0324ad511b7e327a597d9a0d27e5a7d9f4fbc07/extensions/spine/CCSkeleton.js",
