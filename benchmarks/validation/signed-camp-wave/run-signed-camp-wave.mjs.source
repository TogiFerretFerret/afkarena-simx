import{readFile,writeFile,mkdir,readdir,open,stat}from'node:fs/promises';import{resolve}from'node:path';import{createHash}from'node:crypto';import{spawn}from'node:child_process';import{gzipSync,gunzipSync}from'node:zlib';import assert from'node:assert/strict';
const root='/workspace/afkarena-simx',label='signed-camp-wave',out=resolve(root,'benchmarks/validation',label),file=resolve(out,'summary.json'),sha=bytes=>createHash('sha256').update(bytes).digest('hex'),rustBin=resolve(root,'work/toolchain/rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin'),cargo=resolve(rustBin,'cargo'),target=resolve(root,'work/signed-camp-gates-target');
const oldGates=['source-selective-prototype','stage-range-parser-specialization','buff-percent-loop','data-obj-specialization','one-hop-slots','primary-numeric-arrays','closures','reflection-bootstrap','arguments-elision','diagnostics','errors','date','arrays','array-from','array-constructor','generated-typed-arrays','json','coercions','control-flow','values'],gates=[...oldGates,'battle-mode-limit-specialization','shared-utf16','strings','primary-numeric-access','copy-obj-specialization','canonical-small-index-contract'];
assert.ok(process.argv.includes('--frozen-by-root'),'Wait for explicit root FREEZE before launching');
const state={version:2,passed:false,complete:false,label,pid:process.pid,startedAt:new Date().toISOString(),stage:'snapshot',gates:[],inputs:{},oldGateCount:oldGates.length,sourceGateCount:gates.length,scope:'Frozen combined native library/integration tests and source differential gates, then source regeneration and complete release build/original20measured3warmup Node comparison. Component unsupported cases remain explicit; not random20k battle qualification.'};await mkdir(out,{recursive:true});const save=()=>writeFile(file,JSON.stringify(state,null,2)+'\n');await save();
async function track(path){const absolute=resolve(root,path);state.inputs[absolute]=sha(await readFile(absolute));}
async function tree(directory){for(const entry of await readdir(resolve(root,directory),{withFileTypes:true})){const path=directory+'/'+entry.name;if(entry.isDirectory())await tree(path);else if(path.endsWith('.rs')||path.endsWith('.js')||entry.name==='Cargo.toml')await track(path);}}
for(const directory of['crates/js-runtime','crates/battle-core','third-party'])await tree(directory);
for(const path of['Cargo.toml','Cargo.lock','package.json','package-lock.json','rust-toolchain.toml','tools/rust-port/generate-program.mjs','tools/rust-port/battle-gc-proof.mjs','tools/rust-port/program-host.rs','tools/rust-port/compile.mjs','tools/rust-port/expressions.mjs','tools/rust-port/statements.mjs','tools/rust-port/bindings.mjs','tools/rust-port/build-program.mjs','tools/rust-port/check-program.mjs','tools/rust-port/build-and-validate-program.mjs','tools/rust-port/check-program-features.mjs',...gates.map(name=>'tools/rust-port/check-'+name+'.mjs')])await track(path);
for(const entry of await readdir(resolve(root,'config')))if(entry.endsWith('.json'))await track('config/'+entry);
const coverageFile=resolve(root,'benchmarks/validation/rust-battle-compile-coverage.json');await track(coverageFile);const coverage=JSON.parse(await readFile(coverageFile));for(const unit of coverage.units){await track(unit.file);assert.equal(state.inputs[resolve(root,unit.file)],unit.sha256);}await track(import.meta.filename);
const frozenArchive=gzipSync(Buffer.from(JSON.stringify(await Promise.all(Object.keys(state.inputs).map(async file=>({file,sha256:state.inputs[file],base64:(await readFile(file)).toString('base64')}))))));await writeFile(resolve(out,'frozen-inputs.json.gz'),frozenArchive);state.frozenArchive={file:resolve(out,'frozen-inputs.json.gz'),sha256:sha(frozenArchive)};await save();
async function unchanged(){const changed=[];for(const[path,digest]of Object.entries(state.inputs)){let actual=null;try{actual=sha(await readFile(path))}catch{}if(actual!==digest)changed.push({file:path,before:digest,after:actual});}state.changedInputs=changed;await save();assert.equal(changed.length,0,'Frozen source inputs changed');}
const environment={...process.env,PATH:rustBin+':'+process.env.PATH,CARGO_BUILD_JOBS:'1',CARGO_PROFILE_RELEASE_CODEGEN_UNITS:'64',CARGO_PROFILE_RELEASE_LTO:'false',RUST_PORT_TRACE:'0'};
async function run(name,command){await unchanged();state.stage=name;await save();const stdoutFile=resolve(out,name+'.stdout'),stderrFile=resolve(out,name+'.stderr'),stdout=await open(stdoutFile,'w'),stderr=await open(stderrFile,'w'),startedAt=new Date().toISOString(),start=performance.now();
 const execution=await new Promise(accept=>{const child=spawn(command[0],command.slice(1),{cwd:root,env:environment,stdio:['ignore',stdout.fd,stderr.fd]});let error=null;child.once('error',e=>error=String(e));child.once('close',(status,signal)=>accept({pid:child.pid,status,signal,error}));});await stdout.close();await stderr.close();const row={name,command,startedAt,finishedAt:new Date().toISOString(),wallMs:performance.now()-start,...execution,passed:execution.status===0&&execution.signal===null&&execution.error===null,frozenInputManifestSha256:sha(Buffer.from(JSON.stringify(state.inputs))),frozenArchiveSha256:state.frozenArchive.sha256,artifacts:[]};for(const[stream,path]of[['stdout',stdoutFile],['stderr',stderrFile]]){const bytes=await readFile(path),compressed=gzipSync(bytes),archive=path+'.gz';await writeFile(archive,compressed);row.artifacts.push({stream,file:archive,sha256:sha(compressed),uncompressedSha256:sha(bytes)});}if(gates.includes(name)){const gateArchive=resolve(out,'gate-artifacts',name);await mkdir(gateArchive,{recursive:true});row.sourceGateArtifacts=[];for(const entry of await readdir(resolve(root,'benchmarks/validation'),{withFileTypes:true})){if(!entry.isFile())continue;const original=resolve(root,'benchmarks/validation',entry.name);if((await stat(original)).mtimeMs<Date.parse(startedAt))continue;const bytes=await readFile(original),archived=resolve(gateArchive,entry.name+'.gz');const compressed=gzipSync(bytes);await writeFile(archived,compressed);row.sourceGateArtifacts.push({original,file:archived,sha256:sha(compressed),uncompressedSha256:sha(bytes)});}}state.gates.push(row);await save();console.log(JSON.stringify({name,passed:row.passed,wallMs:row.wallMs}));assert.equal(row.passed,true,'Gate failed '+name+': '+(await readFile(stderrFile,'utf8')).slice(-5000));await unchanged();return row;
}
try{
 await run('native-library-and-integration',[cargo,'test','--offline','--locked','-p','js-runtime','-p','battle-core','--lib','--tests','-j','1','--target-dir',target]);
 const nativeStdout=await readFile(resolve(out,'native-library-and-integration.stdout'),'utf8');state.nativeTestSuites=[...nativeStdout.matchAll(/test result: ok\. (\d+) passed; (\d+) failed;/g)].map(match=>({passed:Number(match[1]),failed:Number(match[2])}));assert.ok(state.nativeTestSuites.length>0);assert.ok(state.nativeTestSuites.every(row=>row.failed===0));state.nativeTestsPassed=state.nativeTestSuites.reduce((sum,row)=>sum+row.passed,0);const nativeExecutableDigests=[];for(const entry of await readdir(resolve(target,'debug/deps'),{withFileTypes:true})){const path=resolve(target,'debug/deps',entry.name);if(entry.isFile()&&((await stat(path)).mode&0o111))nativeExecutableDigests.push({file:path,sha256:sha(await readFile(path)),bytes:(await stat(path)).size});}await writeFile(resolve(out,'native-test-binaries.json'),JSON.stringify(nativeExecutableDigests,null,2)+'\n');await save();
 await run('value-example',[cargo,'build','--offline','--locked','--release','-p','js-runtime','--example','value_check','-j','1','--target-dir',target]);
 for(const name of gates){await run(name,[process.execPath,'--jitless',resolve(root,'tools/rust-port/check-'+name+'.mjs'),...(name==='values'?[resolve(target,'release/examples/value_check')]:[])]);if(name==='battle-mode-limit-specialization'){const report=JSON.parse(await readFile(resolve(root,'benchmarks/validation/rust-generated-battle-mode-limit-specialization.json')));assert.equal(report.passed,true);assert.equal(report.coveredCases,112);assert.equal(report.knownUnsupportedCases,2);state.outerQualification={coveredCases:112,knownUnsupportedCases:2,scope:'Baseline sloppy Function.caller remains unsupported in both modes.'};}if(name==='shared-utf16'){const report=JSON.parse(await readFile(resolve(root,'benchmarks/validation/rust-port-shared-utf16.json')));assert.equal(report.passed,true);assert.equal(report.cases,14);}}
 state.sourceValidationComplete=true;await save();
 await run('generate',[process.execPath,resolve(root,'tools/rust-port/generate-program.mjs'),'--through','6','--out','work/rust-battle-full','--chunk-size','100','--gc-cadence','2']);
 const manifest=JSON.parse(await readFile(resolve(root,'work/rust-battle-full/program-manifest.json')));assert.equal(manifest.nativeBattleGcCadence,2);assert.equal(manifest.units.length,7);assert.equal(manifest.units.reduce((sum,unit)=>sum+unit.functions,0),22986);assert.equal(manifest.units.reduce((sum,unit)=>sum+unit.unsupportedFunctions,0),0);state.generated={functions:22986,unsupportedFunctions:0,gcCadence:2,manifestSha256:sha(await readFile(resolve(root,'work/rust-battle-full/program-manifest.json')))};await save();
 await run('generated-lock',[cargo,'generate-lockfile','--offline','--manifest-path',resolve(root,'work/rust-battle-full/Cargo.toml')]);
 await run('build-and-full',[process.execPath,resolve(root,'tools/rust-port/build-and-validate-program.mjs'),'--label',label,'--expected-gc-cadence','2','--jobs','4']);
 const chainFile=resolve(root,'benchmarks/validation/rust-program-'+label+'-chain.json'),chain=JSON.parse(await readFile(chainFile));assert.equal(chain.passed,true);assert.equal(chain.stage,'passed');assert.equal(chain.full.completed,20);state.fullChain={file:chainFile,sha256:sha(await readFile(chainFile))};const nativeStderrFile=resolve(root,'benchmarks/validation/rust-program-'+label+'-full.native.stderr.gz'),nativeStderr=gunzipSync(await readFile(nativeStderrFile)).toString('utf8'),domainMarkers=[...nativeStderr.matchAll(/^native_domain_admission:battle_mode_limit:(\d+):getter_calls:(\d+)$/gm)],configMarkers=[...nativeStderr.matchAll(/^native_runtime_config:primary_numeric_access:(true|false):battle_mode_limit:(true|false)$/gm)];assert.equal(domainMarkers.length,1);assert.equal(configMarkers.length,1);assert.deepEqual(configMarkers[0].slice(1),['true','true']);state.actualNativeAdmission={stderrFile:nativeStderrFile,stderrSha256:sha(await readFile(nativeStderrFile)),battleModeLimitDomainHits:Number(domainMarkers[0][1]),getterCalls:Number(domainMarkers[0][2]),primaryNumericAccessEnabled:true,battleModeLimitEnabled:true};state.optimizationQualification={passed:state.actualNativeAdmission.battleModeLimitDomainHits>0&&state.actualNativeAdmission.getterCalls>0,requiredActualDomainHitsPositive:true,requiredActualGetterCallsPositive:true};if(!state.optimizationQualification.passed)state.optimizationQualification.reason='Faithful full report passed but actual domain/getter admission was not positive';await unchanged();state.complete=true;state.passed=true;state.stage='passed';state.forkNextCommand=[process.execPath,resolve(root,'tools/rust-port/benchmark-fork-program.mjs'),'--run','--serial-slot-released','--baseline',resolve(root,'benchmarks/validation/rust-program-'+label+'-full.json')];
}catch(error){state.error=String(error.stack??error);state.stage='failed';process.exitCode=1;}state.finishedAt=new Date().toISOString();await save();console.log(JSON.stringify({file,passed:state.passed,stage:state.stage,error:state.error}));
