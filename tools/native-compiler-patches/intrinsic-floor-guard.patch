+// Guard a scalar native specialization without invoking getters, proxy traps,
+// or JavaScript. Unknown descriptor layouts conservatively use source code.
+extern "C" SHERMES_EXPORT bool simx_intrinsic_math_floor_guard(SHRuntime *shr) {
+  Runtime &runtime = getRuntime(shr);
+  auto ownData = [&](JSObject *object, SymbolID key, PinnedHermesValue &value) {
+    if (object->isProxyObject(runtime) || object->isHostObject(runtime))
+      return false;
+    NamedPropertyDescriptor desc;
+    auto found = JSObject::tryGetOwnNamedDescriptorFast(
+        object, runtime, key, desc);
+    if (!found.hasValue() || !found.getValue() || desc.flags.accessor)
+      return false;
+    value = JSObject::getNamedSlotValueUnsafe(object, runtime, desc)
+                .unboxToHV(runtime);
+    return true;
+  };
+  PinnedHermesValue math, floor;
+  if (!ownData(runtime.getGlobal().get(),
+               Predefined::getSymbolID(Predefined::Math), math) ||
+      !math.isObject() ||
+      !ownData(vmcast<JSObject>(math),
+               Predefined::getSymbolID(Predefined::floor), floor) ||
+      !vmisa<NativeFunction>(floor))
+    return false;
+  auto *function = vmcast<NativeFunction>(floor);
+  return function->getFunctionPtr() == runContextFunc1Arg &&
+      function->getContext() == reinterpret_cast<void *>(MathKind::floor);
+}
