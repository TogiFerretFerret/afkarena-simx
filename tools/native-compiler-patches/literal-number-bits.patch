-  }
+  // Preserve the IR literal's bits, including NaN sign/payload. The ordinary
+  // native constant emitter preserves these bits too; object/array buffers
+  // must not change a Number merely because it is serialized.
+  llvh::support::endian::write<double, 1>(
+      buff.data() + buff.size() - sizeof(double),
+      value,
+      llvh::support::endianness::little);
