+// Read only actual own dense Number elements. This preflight invokes no JS,
+// allocates nothing, and never observes proxy/getter/prototype-index behavior.
+extern "C" SHERMES_EXPORT bool simx_dense_finite_vec2(
+    SHRuntime *shr, SHLegacyValue input, double *output) {
+  Runtime &runtime = getRuntime(shr);
+  auto value = HermesValue::fromRaw(input.raw);
+  if (!vmisa<JSArray>(value))
+    return false;
+  auto *array = vmcast<JSArray>(value);
+  if (!array->hasFastIndexProperties(runtime) ||
+      array->getBeginIndex() != 0 || array->getEndIndex() < 2)
+    return false;
+  auto x = array->at(runtime, 0).unboxToHV(runtime);
+  auto y = array->at(runtime, 1).unboxToHV(runtime);
+  if (!x.isNumber() || !y.isNumber() ||
+      !std::isfinite(x.getNumber()) || !std::isfinite(y.getNumber()))
+    return false;
+  output[0] = x.getNumber();
+  output[1] = y.getNumber();
+  return true;
+}
