2024\/actmira_material_tree.jpg","Type":"material"},"4011103":{"ID":4011103,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"引灵铃","Description":"由矮人铁匠的巧手锻造而成，每一声清脆的铃音都蕴藏着神秘的力量，能引领兽灵朝着指定方向行进。","IconRes":"res\/ui\/panel\/activity_midwinter2024\/actmira_material_bell.jpg","Type":"material"},"4011104":{"ID":4011104,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"幽夜藤草","Description":"源自班题斯王国的神秘植物，生于幽暗，却不易腐朽，能在黑暗中散发出微光，其坚韧的特性可用于编织纺物。","IconRes":"res\/ui\/panel\/activity_midwinter2024\/actmira_material_carpet.jpg","Type":"material"},"4011105":{"ID":4011105,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"永寂霜雪","Description":"传说中它是冬喉女士洒下的霜雪，存在于诸神群山之巅，仿佛冻结了时间，在流逝的时光中岿然不动，永不融化。","IconRes":"res\/ui\/panel\/activity_midwinter2024\/actmira_material_crystalball.jpg","Type":"material"},"4011106":{"ID":4011106,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"恒焰熔石","Description":"源于火山熔岩之间，无穷的热量由石心传递至石壁，炽热却不会灼伤肌肤，宛如永恒的火焰之心。","IconRes":"res\/ui\/panel\/activity_midwinter2024\/actmira_material_fireplace.jpg","Type":"material"},"4011107":{"ID":4011107,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"月吟琴弦","Description":"专为追求至纯音律的竖琴演奏家而打造的琴弦，音质澄澈优雅，是演绎动人旋律的必备之选。","IconRes":"res\/ui\/panel\/activity_midwinter2024\/actmira_material_harp.jpg","Type":"material"},"4011108":{"ID":4011108,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"迷你工坊","Description":"收纳着不同打造工具的箱包，每件工具各司其职，能满足制作者从零到一的制作需求，打造完美家具。","IconRes":"res\/ui\/panel\/activity_midwinter2024\/make_tool_all_samll.jpg","Type":"tool"},"4011109":{"ID":4011109,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"魔绘喷枪","Description":"由幻夜林中的魔花提炼而成的颜料，能够喷涂出幻梦般的绚丽色泽，赋予家具独特的视觉魅力。","IconRes":"res\/ui\/panel\/activity_midwinter2024\/make_tool_aesthetics_samll.jpg","Type":"tool"},"4011110":{"ID":4011110,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"铁流锻锤","Description":"由矮人工匠制造的锻造之锤，能敲打出超乎寻常的耐用结构，使每件家具都能抵御岁月的侵蚀。","IconRes":"res\/ui\/panel\/activity_midwinter2024\/make_tool_durability_samll.jpg","Type":"tool"},"4011111":{"ID":4011111,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"灵韵绘梦笔","Description":"能将幻想转变为现实的神奇画笔，每一笔都能激发创作者新的灵感，赋予家具超凡的视觉创意。","IconRes":"res\/ui\/panel\/activity_midwinter2024\/make_tool_creativity_samll.jpg","Type":"tool"},"4011112":{"ID":4011112,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"固韧砺石","Description":"源于矮人工坊，能够将家具表面打磨得如同丝绸般柔滑，为每一次触摸带来与众不同的手感。","IconRes":"res\/ui\/panel\/activity_midwinter2024\/make_tool_feel_samll.jpg","Type":"tool"},"4011113":{"ID":4011113,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"难忘时刻","Description":" ","IconRes":"res\/ui\/panel\/activity_summer2024\/explore_note_pic_icon.png","Type":"picture"},"4011114":{"ID":4011114,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"难忘时刻","Description":" ","IconRes":"res\/ui\/panel\/activity_summer2024\/explore_note_pic_icon.png","Type":"picture"},"4011115":{"ID":4011115,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"难忘时刻","Description":" ","IconRes":"res\/ui\/panel\/activity_summer2024\/explore_note_pic_icon.png","Type":"picture"},"4011116":{"ID":4011116,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"难忘时刻","Description":" ","IconRes":"res\/ui\/panel\/activity_summer2024\/explore_note_pic_icon.png","Type":"picture"},"4011117":{"ID":4011117,"Res":"","MIN":0,"MAX":0,"Init":0,"Visiable":false,"ShowMax":false,"RaidID":4011,"Name":"难忘时刻","Description":" ","IconRes":"res\/ui\/panel\/activity_summer2024\/explore_note_pic_icon.png","Type":"picture"},"4011118":{"ID":401111